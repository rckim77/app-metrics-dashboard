# Copy this next to your app's dashboard config as metrics-dashboard.env.
# It is loaded without overriding variables already exported in your shell.

# Optional Firebase / GA4 BigQuery service account. You can also use
# firebase.credentialFiles in the JSON config.
# export GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

# Optional overrides when dataset discovery is unavailable.
# export FIREBASE_BQ_PROJECT_ID="example-firebase-project"
# export FIREBASE_BQ_DATASET="analytics_123456789"

# RevenueCat server-side secret key and project id.
# export REVENUECAT_API_KEY="sk_..."
# export REVENUECAT_PROJECT_ID="proj_..."

# Optional ASC CLI analytics timeout.
# export ASC_TIMEOUT="120s"
